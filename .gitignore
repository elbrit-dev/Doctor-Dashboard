# dependencies
node_modules/

# build output
dist/
dist-ssr/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# env
.env
.env.local
.env.*.local

# vite cache
.vite/

# Local data sheets (contain PII — never commit/deploy). Ignore EVERYWHERE,
# not just public/, so a stray sheet in the repo root can't be committed.
*.xlsx
*.xls
*.csv

# Local one-off report script (NOT a blanket *.mjs ignore — the Netlify
# functions are .mjs and MUST be committed/deployed).
/hq-report.mjs

# Local shared-completed store (dev only; prod uses Netlify Blobs)
server/completed.json
